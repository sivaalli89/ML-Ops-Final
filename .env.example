# copy to .env (never commit .env)
JUPYTER_TOKEN=namethatllm
# true = also install PyTorch + sentence-transformers so the notebook (and the API) can compute the DistilBERT numbers themselves
INSTALL_EMBEDDINGS=false

# Airflow (docker compose --profile airflow up)
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me

# the port MLflow is published on (5000 is often taken)
MLFLOW_PORT=5050
